     ]
    }
   ],
   "source": [
    "janvier_septembre = analyse.loc[analyse[\"mois\"] <= 9]\n",
    "comparaison = janvier_septembre.groupby(\"annee\").agg(\n",
    "    effectifs=(\"effectifs\", \"sum\"),\n",
    "    retards=(\"Nombre de trains en retard à l'arrivée\", \"sum\"),\n",
    ")\n",
    "comparaison[\"taux_retard\"] = 100 * comparaison[\"retards\"] / comparaison[\"effectifs\"]\n",
    "display(comparaison)\n",
    "\n",
    "comparaison[\"taux_retard\"].plot.bar(color=\"teal\")\n",
    "plt.title(\"Retards à l'arrivée : janvier-septembre uniquement\")\n",
    "plt.ylabel(\"Taux (%)\")\n",
    "plt.xticks(rotation=0)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "ecart = comparaison.loc[2026, \"taux_retard\"] - comparaison.loc[2025, \"taux_retard\"]\n",
    "print(f\"Entre janvier-septembre 2025 et 2026 : {ecart:+.2f} points de pourcentage.\")\n",
    "print(\"Les mois sont comparables, mais les volumes et leur répartition entre liaisons peuvent changer.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-19",
   "metadata": {},
   "source": [
    "## 7. Profil des mois de l'année\n",
    "\n",
    "Pour le profil saisonnier, on prend seulement les années ayant douze mois. Cela décrit les mois observés sans isoler un effet causal de la saison."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "cell-20",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mois au taux agrégé le plus élevé : Juil\n"
     ]
    }
   ],
   "source": [
    "annees_completes = annuel.index[annuel[\"mois_observes\"] == 12]\n",
    "donnees_completes = analyse.loc[analyse[\"annee\"].isin(annees_completes)]\n",
    "\n",
    "saisonnalite = donnees_completes.groupby(\"mois\").agg(\n",
    "    retards=(\"Nombre de trains en retard à l'arrivée\", \"sum\"),\n",
    "    effectifs=(\"effectifs\", \"sum\"),\n",
    ")\n",
    "saisonnalite[\"taux_retard\"] = 100 * saisonnalite[\"retards\"] / saisonnalite[\"effectifs\"]\n",
    "noms_mois = [\"Jan\", \"Fév\", \"Mar\", \"Avr\", \"Mai\", \"Juin\", \"Juil\", \"Août\", \"Sep\", \"Oct\", \"Nov\", \"Déc\"]\n",
    "\n",
    "saisonnalite[\"taux_retard\"].plot.bar(color=\"teal\")\n",
    "plt.xticks(range(12), noms_mois, rotation=0)\n",
    "plt.ylabel(\"Taux de retard arrivée (%)\")\n",
    "plt.title(\"Profil mensuel sur les années complètes\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"Mois au taux agrégé le plus élevé :\", noms_mois[saisonnalite[\"taux_retard\"].idxmax() - 1])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "cell-21",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# La carte conserve aussi 2026. Les mois absents ne deviennent pas des zéros.\n",
    "carte = mensuel[[\"taux_retard\"]].copy()\n",
    "carte[\"annee\"] = carte.index.year\n",
    "carte[\"mois\"] = carte.index.month\n",
    "carte = carte.pivot(index=\"annee\", columns=\"mois\", values=\"taux_retard\")\n",
    "\n",
    "plt.figure(figsize=(12, 5))\n",
    "plt.imshow(carte, cmap=\"YlOrRd\", aspect=\"auto\", vmin=0)\n",
    "plt.xticks(range(12), noms_mois)\n",
    "plt.yticks(range(len(carte)), carte.index)\n",
    "plt.colorbar(label=\"Taux de retard arrivée (%)\")\n",
    "for ligne in range(len(carte)):\n",
    "    for colonne in range(12):\n",
    "        valeur = carte.iloc[ligne, colonne]\n",
    "        if pd.notna(valeur):\n",
    "            couleur = \"white\" if valeur > 30 else \"black\"\n",
    "            plt.text(colonne, ligne, f\"{valeur:.1f}\", ha=\"center\", va=\"center\", color=couleur)\n",
    "plt.title(\"Retards à l'arrivée par année et par mois\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-22",
   "metadata": {},
   "source": [
    "## 8. National et International\n",
    "\n",
    "Les catégories sont utilisées telles qu'elles figurent dans le fichier. Les parcours et les volumes diffèrent : les écarts ne prouvent pas un effet du passage des frontières."
   ]
  },
